PORT=3001
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/real_i

# Generate your own: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-unique-secret-of-at-least-32-characters
JWT_ACCESS_SECRET=replace-with-a-different-unique-secret-of-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-third-unique-secret-of-at-least-32-characters
JWT_EXPIRES_IN=15m

# Required for the AI tutor, quiz generation and lecture summaries
GROQ_API_KEY=replace-with-groq-api-key

FRONTEND_URL=http://localhost:3001
NODE_ENV=development
