MONGODB_URI=mongodb://localhost:27017/real_i
# JSON object. Keep the previous key only for the short rotation overlap.
AI_INTERNAL_JWT_KEYS_JSON={"2026-01":"replace-with-32-plus-character-secret"}
AI_INTERNAL_JWT_ISSUER=real-i-core-api
AI_INTERNAL_JWT_AUDIENCE=real-i-ai
OPENROUTER_API_KEY=replace-with-openrouter-key
# Ordered primary-to-fallback model identifiers; deployment owns the actual choice.
OPENROUTER_MODEL_ORDER=primary-model-id,fallback-model-id
OPENROUTER_EMBEDDING_MODEL=embedding-model-id
# Must exactly match the configured embedding model and Atlas vector-index dimension.
OPENROUTER_EMBEDDING_DIMENSIONS=1536
MONGODB_VECTOR_INDEX=ai_vector_chunks_by_course
MAX_INGEST_BYTES=5242880
MAX_CHUNKS_PER_DOCUMENT=2000
# Placeholder only: choose a production course-wide material quota before launch.
MAX_CHUNKS_PER_COURSE=10000
# Placeholder only: Core API will enforce this per-user chat limit in step 9.
AI_CHAT_RATE_LIMIT_PER_MINUTE=10
LOG_LEVEL=INFO
